{
  "name": "agent-primitives",
  "version": "0.22.1",
  "description": "Agent-first CLI primitives (bounded JSON envelopes, a mutation-probe runner, a verify runner, a PATH doctor, an identifier-drift guard, a commit-hygiene guard, an exact-text patcher, checkout snapshot/delta, and a skill installer) for narrow subagents",
  "type": "module",
  "bin": {
    "agent-primitives": "./dist/cli.js"
  },
  "exports": {
    "./schemas/evidence-envelope.json": "./schemas/evidence-envelope.json",
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "dist",
    "assets",
    "docs",
    "schemas",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "dev": "node --import tsx src/cli.ts",
    "pretest": "npm run build",
    "test": "vitest run",
    "format": "prettier --write \"*.ts\" \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"*.ts\" \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "mutation-testing",
    "verify",
    "dx"
  ],
  "author": "Lan Nguyen Si",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LanNguyenSi/agent-dx.git",
    "directory": "packages/agent-primitives"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "eslint": {
      "minimatch": "11.0.4"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.4"
    }
  }
}
