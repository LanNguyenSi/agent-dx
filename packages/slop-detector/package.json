{
  "name": "slop-detector",
  "version": "0.3.1",
  "description": "Configurable AI-slop linter for PRs — catches the visible tells of AI-generated code, prose, and UIs",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "slop-detector": "./dist/cli.js",
    "slop-detector-mcp": "./dist/mcp.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./packs/agent-tics": "./dist/packs/agent-tics.js",
    "./packs/prose-slop": "./dist/packs/prose-slop.js",
    "./packs/comment-slop": "./dist/packs/comment-slop.js",
    "./packs/code-slop": "./dist/packs/code-slop.js",
    "./packs/placement-slop": "./dist/packs/placement-slop.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "dev": "node --import tsx src/cli.ts",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "keywords": [
    "ai",
    "agent",
    "lint",
    "slop",
    "pr-review",
    "dx",
    "claude",
    "playbook"
  ],
  "author": "Lava (@lavaclawdbot) & Lan Nguyen Si",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LanNguyenSi/agent-dx.git",
    "directory": "packages/slop-detector"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@typescript-eslint/parser": "^8.59.1",
    "@typescript-eslint/types": "^8.59.1",
    "commander": "^12.0.0",
    "yaml": "^2.8.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "prettier": "^3.8.1",
    "tsx": "^4.22.4",
    "typescript": "^5.3.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=20"
  }
}
